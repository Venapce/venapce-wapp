# Venapce backend (venapce-api) base URL. Defaults to http://localhost:8091
# (the dev port in venapce-api/.env). Point this at your backend if different.
VITE_VENAPCE_API_URL=http://localhost:8091

# Optional: prefill the Superset URL on the Settings screen.
VITE_SUPERSET_URL=http://localhost:8088
